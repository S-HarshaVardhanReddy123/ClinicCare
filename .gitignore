# ==========================================
# ClinicCare - Git Ignore
# ==========================================

# Node.js dependencies
node_modules/

# Environment variables
.env
.env.local
.env.development
.env.production

# Keep the example environment file
!.env.example

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Temporary files
tmp/
temp/

# Operating system files
.DS_Store
Thumbs.db

# VS Code settings
.vscode/*
!.vscode/extensions.json

# Uploads
uploads/

# Generated files
*.tmp

# Docker
*.tar

# Database local files
*.sqlite
*.sqlite3

# Certificates / private keys
*.pem
*.key